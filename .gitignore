# Portfolio - Blue/White/Black Theme
# .gitignore

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# Editor Directories and Files
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/
*.sublime-project
*.sublime-workspace

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Dependency Directories (se adicionar build tools)
node_modules/
jspm_packages/

# Build Output (se adicionar minificação)
dist/
build/
*.min.css
*.min.js
*.map

# Temporary Files
tmp/
temp/
*.tmp

# Backup Files
*.bak
*.backup
*~

# Environment Variables (se adicionar backend)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Package Manager Files (se adicionar)
package-lock.json
yarn.lock
pnpm-lock.yaml

# Testing (se adicionar testes)
coverage/
.nyc_output/
*.lcov

# Cache
.cache/
.parcel-cache/

# Misc
*.psd
*.ai
*.sketch
